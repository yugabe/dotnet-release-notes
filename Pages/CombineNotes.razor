@page "/combine"
@inject DotNetReleaseNotesCombiner.Services.MarkdownFetchService MarkdownFetchService

<PageTitle>Combine Release Notes</PageTitle>

<div class="combine-page px-4 py-3">
    <h1>.NET Preview Release Notes Combiner</h1>

    <div class="row gy-3">
        <div class="col-md-6">
            <label for="versionSelect" class="form-label">Release version</label>
            <select id="versionSelect" class="form-select" value="@SelectedVersion" @onchange="OnVersionChanged">
                <option value="">Select a version</option>
                @foreach (var version in AvailableVersions)
                {
                    <option value="@version">@version</option>
                }
            </select>
        </div>

        <div class="col-md-6">
            <label for="previewSelect" class="form-label">Preview release</label>
            <select id="previewSelect" class="form-select" @bind="SelectedPreview" disabled="@(AvailablePreviews.Count == 0)">
                <option value="">Select a preview</option>
                @foreach (var preview in AvailablePreviews)
                {
                    <option value="@preview">@preview</option>
                }
            </select>
        </div>
    </div>

    <div class="mt-3">
        <label for="sourceUrl" class="form-label">Custom URL or path</label>
        <input id="sourceUrl" class="form-control" @bind="SourceUrl" placeholder="Optional: https://github.com/dotnet/core/release-notes/11.0/preview/preview4" />
        <div class="form-text">If you want to target a custom path, enter it here. Otherwise select version and preview above.</div>
    </div>

    <div class="mt-3 row gx-3 gy-2 align-items-center">
        <div class="col-md-6 form-check">
            <input id="useGitHubHtml" class="form-check-input" type="checkbox" @bind="UseGitHubRenderedHtml" />
            <label class="form-check-label" for="useGitHubHtml">Try GitHub-rendered HTML first</label>
            <div class="form-text">If GitHub server-side HTML rendering is available, the app will use it and fall back to Markdown rendering.</div>
        </div>

        <div class="col-md-6 text-md-end">
            <button class="btn btn-primary" @onclick="CombineAsync" disabled="@(IsLoading || (!HasVersionAndPreview && string.IsNullOrWhiteSpace(SourceUrl)))">Combine</button>
            <button class="btn btn-secondary ms-2" @onclick="ClearResults" disabled="@IsLoading">Clear</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="alert alert-info mt-3">@StatusMessage</div>
    }

    @if (IsLoading)
    {
        <div class="spinner-border mt-3" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(CombinedHtml))
    {
        <div class="combined-output mt-4">
            <h2>Combined Release Notes</h2>
            <div class="combined-content" @ref="OutputElement">
                @((MarkupString)CombinedHtml)
            </div>
        </div>
    }
</div>

@code {
    private string SourceUrl { get; set; } = string.Empty;
    private string SelectedVersion { get; set; } = string.Empty;
    private string SelectedPreview { get; set; } = string.Empty;
    private List<string> AvailableVersions { get; set; } = new();
    private List<string> AvailablePreviews { get; set; } = new();
    private string CombinedHtml { get; set; } = string.Empty;
    private string StatusMessage { get; set; } = string.Empty;
    private bool IsLoading { get; set; }
    private bool UseGitHubRenderedHtml { get; set; } = true;
    private ElementReference OutputElement;

    private bool HasVersionAndPreview => !string.IsNullOrWhiteSpace(SelectedVersion) && !string.IsNullOrWhiteSpace(SelectedPreview);

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        StatusMessage = "Loading available release versions...";

        try
        {
            AvailableVersions = (await MarkdownFetchService.GetAvailableReleaseNoteVersionsAsync()).ToList();
            StatusMessage = "Select a version and preview release, or enter a custom path.";
        }
        catch (Exception ex)
        {
            StatusMessage = $"Unable to load versions: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OnVersionChanged(ChangeEventArgs args)
    {
        SelectedVersion = args.Value?.ToString() ?? string.Empty;
        SelectedPreview = string.Empty;
        AvailablePreviews.Clear();

        if (!string.IsNullOrWhiteSpace(SelectedVersion))
        {
            IsLoading = true;
            StatusMessage = $"Loading previews for {SelectedVersion}...";

            try
            {
                AvailablePreviews = (await MarkdownFetchService.GetAvailablePreviewReleasesAsync(SelectedVersion)).ToList();
                StatusMessage = AvailablePreviews.Count > 0 ? "Select a preview release." : "No preview releases found for this version.";
            }
            catch (Exception ex)
            {
                StatusMessage = $"Unable to load previews: {ex.Message}";
            }
            finally
            {
                IsLoading = false;
            }
        }
    }

    private async Task CombineAsync()
    {
        IsLoading = true;
        StatusMessage = "Starting combine process...";
        CombinedHtml = string.Empty;

        try
        {
            var source = string.Empty;
            if (!string.IsNullOrWhiteSpace(SourceUrl))
            {
                source = SourceUrl;
            }
            else if (HasVersionAndPreview)
            {
                source = $"https://github.com/dotnet/core/release-notes/{SelectedVersion}/preview/{SelectedPreview}";
            }

            if (string.IsNullOrWhiteSpace(source))
            {
                StatusMessage = "Please select a version/preview or enter a custom URL.";
                return;
            }

            string? html = null;
            if (UseGitHubRenderedHtml)
            {
                StatusMessage = "Trying GitHub HTML rendering...";
                html = await MarkdownFetchService.TryFetchGitHubRenderedHtmlAsync(source);
            }

            if (!string.IsNullOrEmpty(html))
            {
                CombinedHtml = html;
                StatusMessage = "Rendered successfully using GitHub HTML fallback.";
            }
            else
            {
                var markdown = await MarkdownFetchService.FetchAndCombineAsync(source, new Progress<string>(message => StatusMessage = message));
                CombinedHtml = MarkdownFetchService.ConvertMarkdownToHtml(markdown);
                StatusMessage = "Combined successfully from Markdown.";
            }
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ClearResults()
    {
        SourceUrl = string.Empty;
        SelectedVersion = string.Empty;
        SelectedPreview = string.Empty;
        AvailablePreviews.Clear();
        CombinedHtml = string.Empty;
        StatusMessage = string.Empty;
    }
}
