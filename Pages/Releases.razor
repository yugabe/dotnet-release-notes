@page "/releases"
@page "/releases/{*ReleasePath}"
@page "/release-notes"
@page "/release-notes/{*ReleasePath}"
@using Microsoft.AspNetCore.Components.Rendering
@inject DotNetReleaseNotesCombiner.Services.MarkdownFetchService MarkdownFetchService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Release Notes Browser</PageTitle>
<div class="combine-page px-4 py-3 @(IsWideLayout ? "release-page-wide" : "")">
    <div class="release-topbar mb-3">
        <div class="release-topbar-left">
            @if (ShowNavigation) { <button class="btn btn-outline-secondary btn-sm release-nav-toggle" @onclick="ToggleNavigation" aria-label="Toggle navigation"><span class="hamburger">☰</span></button> }
            @if (!string.IsNullOrEmpty(SourceUrl)) { <a class="source-link text-truncate" href="@SourceUrl" target="_blank" rel="noopener noreferrer">@SourceUrl</a> }
            else
            {
                var display = "release-notes" + (string.IsNullOrEmpty(CurrentPath) ? "" : "/" + CurrentPath);
                <a class="source-link text-truncate" href="@GetSourceUrlForPath(NormalizePath(CurrentPath), DirectoryEntries ?? [])" target="_blank" rel="noopener noreferrer">@display</a>
            }
        </div>
        <div class="release-topbar-center">
            @if (IsLoading) { <div class="spinner-border spinner-border-sm text-secondary" role="status"><span class="visually-hidden">Loading</span></div> }
        </div>
        <div class="release-topbar-right">
            <button class="btn btn-outline-secondary btn-sm me-2" @onclick="CycleThemeMode" aria-label="@GetThemeButtonTitle()" title="@GetThemeButtonTitle()">@GetThemeButtonIcon()</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleWideLayout" aria-pressed="@IsWideLayout" aria-label="@(IsWideLayout ? "Switch to narrow layout" : "Switch to wide layout")" title="@(IsWideLayout ? "Switch to narrow layout" : "Switch to wide layout")">@(IsWideLayout ? "⤡" : "⤢")</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage)) { <div class="alert alert-danger mt-2">@ErrorMessage</div> }
    <div class="release-notes-layout @(!IsNavigationVisible ? "collapsed-nav" : "")">
        <aside class="release-sidebar @(IsNavigationVisible ? "nav-open" : "nav-closed")" aria-hidden="@(!IsNavigationVisible)">
            <div class="release-sidebar-inner"><div class="sidebar-card mb-3">
                @if (HeadingTree.Count > 0)
                {
                    <div class="sidebar-section mb-3"><ul class="list-unstyled overview-tree mb-0">
                        @foreach (var node in HeadingTree) { @RenderHeadingNode(node) }
                    </ul></div>
                }
            </div></div>
        </aside>
        @if (ShowNavigation) { <button class="release-sidebar-backdrop @(IsNavigationVisible ? "visible" : "")" aria-label="Close navigation" tabindex="-1" @onclick="CloseNavigation"></button> }

        <section class="release-main">
            <div class="directory-card mb-3">
                <div class="directory-header d-flex justify-content-between align-items-center mb-2">
                    <nav class="directory-breadcrumb" aria-label="Breadcrumb"><ol class="breadcrumb mb-0">
                        @if (BreadcrumbSegments.Count == 0) { <li class="breadcrumb-item active" aria-current="page"><span class="text-body">release-notes</span></li> }
                        else { <li class="breadcrumb-item"><a class="text-decoration-none" href="/release-notes">release-notes</a></li> }
                        @for (var i = 0; i < BreadcrumbSegments.Count; i++)
                        {
                            var segment = BreadcrumbSegments[i];
                            @if (i == BreadcrumbSegments.Count - 1) { <li class="breadcrumb-item active" aria-current="page"><span class="text-body">@segment.Label</span></li> }
                            else { <li class="breadcrumb-item"><a class="text-decoration-none" href="@GetBreadcrumbHref(segment.Path)">@segment.Label</a></li> }
                        }
                    </ol></nav>
                    @if (HasCombinedDocument) { <button class="btn btn-sm btn-outline-secondary directory-toggle" @onclick="ToggleDirectory" aria-expanded="@IsDirectoryCollapsed">@(IsDirectoryCollapsed ? "+" : "−")</button> }
                </div>
                @if (ShouldShowDirectory)
                {
                    @if (DirectoryEntries?.Count == 0) { <div class="alert alert-light">No entries found for this path.</div> }
                    <div class="release-directory-table-wrapper"><div class="table-responsive"><table class="table table-borderless table-sm mb-0 directory-table"><tbody>
                        @if (!string.IsNullOrEmpty(ParentPath))
                        {
                            <tr><td class="py-1 px-0" style="white-space: nowrap;"><a href="@GetParentHref()" class="text-decoration-none d-flex align-items-center"><span class="me-2">📁</span><span>..</span></a></td></tr>
                        }
                        @foreach (var entry in SortedDirectoryEntries)
                        {
                            var isDir = entry.Type.Equals("dir", StringComparison.OrdinalIgnoreCase);
                            <tr><td class="py-1 px-0" style="white-space: nowrap;"><a class="text-decoration-none d-flex align-items-center" href="@GetEntryHref(entry)"><span class="me-2">@(isDir ? "📁" : "📄")</span><span>@entry.Name</span></a></td></tr>
                        }
                    </tbody></table></div></div>
                }
            </div>

            @if (CombinedSections.Count > 0)
            {
                <div class="combined-output mt-4"><div class="combined-content">
                    @for (var i = 0; i < CombinedSections.Count; i++)
                    {
                        var section = CombinedSections[i];
                        @if (i == 0) { <div class="included-section-root">@((MarkupString)section.Html)</div> }
                        else
                        {
                            <details class="included-section"><summary><span class="included-section-summary-title">@section.Title</span>
                                @if (!string.IsNullOrWhiteSpace(section.SourceUrl))
                                {
                                    <input type="checkbox" class="form-check-input included-read-toggle" checked="@IsIncludedSectionRead(section.SourceUrl)" aria-label="Mark included section as read" @onclick:stopPropagation="true" @onchange="@(e => OnIncludedReadChangedAsync(section.SourceUrl, e))" />
                                }
                            </summary><div class="included-section-body">
                                @if (!string.IsNullOrWhiteSpace(section.SourceUrl)) { <div class="included-section-meta">Included from <a href="@section.SourceUrl" target="_blank" rel="noopener noreferrer">@section.SourceUrl</a></div> }
                                @((MarkupString)section.Html)
                            </div></details>
                        }
                    }
                </div>
                @if (IsLoading) { <div class="combined-loading-overlay" aria-hidden="true"><div class="combined-loading-bars"><span></span><span></span><span></span></div></div> }
                </div>
            }
            else if (IsLoading) { <div class="combined-output combined-loading-shell mt-4" aria-hidden="true"><div class="combined-loading-bars"><span></span><span></span><span></span></div></div> }
        </section>
    </div>
    <button class="scroll-top-btn @(ShowScrollToTop ? "visible" : "")" aria-label="Scroll to top" @onclick="ScrollToTop">↑</button>
</div>

@code {
    RenderFragment<HeadingNode> RenderHeadingNode => node => @<li class="tree-node level-@node.Level @(IsNodeInActivePath(node, _activeHeadingId) ? "active-path" : "")">
        <div class="tree-node-header d-flex align-items-center">
            @if (node.Children.Count > 0) { <button class="tree-toggle btn btn-sm btn-link text-decoration-none text-body-secondary me-2" aria-expanded="@node.IsExpanded" @onclick="() => ToggleHeadingNode(node.Id)">@(node.IsExpanded ? "−" : "+")</button> }
            else { <button class="tree-toggle tree-toggle-placeholder btn btn-sm btn-link text-decoration-none text-body-secondary me-2" aria-hidden="true" tabindex="-1" disabled>+</button> }
            <a class="tree-link overview-link flex-grow-1 @(node.Id == _activeHeadingId ? "active" : "")" href="@GetHeadingHref(node.Id)" data-id="@node.Id" @onclick="OnHeadingLinkClickAsync">@node.Text</a>
        </div>
        @if (node.Children.Count > 0 && node.IsExpanded) { <ul class="list-unstyled tree-children expanded">@foreach (var child in node.Children) { @RenderHeadingNode(child) }</ul> }
    </li>;
}
